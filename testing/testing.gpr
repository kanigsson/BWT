--  The test scaffolding: an assertion counter for the test main and a
--  stopwatch for the benchmarks. Ordinary Ada on purpose: nothing proves it,
--  and a contract here would describe the harness rather than the transforms.
library project Testing is

   for Languages use ("Ada");
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Library_Name use "bwt_testing";
   for Library_Dir use "lib";
   for Library_Kind use "static";

   package Compiler is
      --  A test build: checks on, no optimisation, debuggable.
      for Default_Switches ("Ada") use ("-gnat2022", "-gnata", "-gnatwa", "-g", "-O0");
   end Compiler;

end Testing;
